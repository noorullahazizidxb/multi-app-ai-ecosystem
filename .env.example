# ============================================================================
# MASTER ENVIRONMENT CONTROLLER (.env Specification)
# Options per App: careerforge | kinetic | freelanceos | viralmatrix
# ============================================================================

# 1. APPLICATION IDENTITY & DOMAIN ROUTING
APP_ID="careerforge"
NODE_ENV="production"
DEPLOY_TARGET="hybrid" # "vercel-serverless" | "vps-docker" | "hybrid"
WEB_ORIGIN_URL="https://careerforge.example.com"
API_PUBLIC_URL="https://api.careerforge.example.com"
PORT=4001
WS_PORT=4101

# 2. DYNAMIC DATABASE SELECTOR (PRISMA v8)
# Allowed values: "postgres" | "neon" | "sqlite" | "turso" | "mysql"
DB_DIALECT="neon"
DATABASE_URL="postgresql://user:pass@ep-cool-fog-123.us-east-2.aws.neon.tech/careerforge_db?sslmode=require"
TURSO_DATABASE_URL="libsql://careerforge-org.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSI..."
MYSQL_DATABASE_URL="mysql://root:secret@mysql-vps:3306/careerforge_db"

# 3. REDIS PUB/SUB, USAGE-CAP RATE LIMITING & WEBSOCKETS
REDIS_URL="redis://:redis_super_secret@redis-vps:6379/0" # DB /0..3 per app
REDIS_PASSWORD="redis_super_secret"
ENABLE_LIVE_ADMIN_WS="true"

# 4. AI ENGINE, MONETIZATION CAPS & THEME ENGINE
GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_COPILOT="gemini-2.5-pro"
FREE_MONTHLY_QUOTA=5
COPILOT_STRIPE_PRICE_ID="price_1Pqxyz..."
DEFAULT_THEME="clean-slate"

