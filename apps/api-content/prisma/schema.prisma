generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContentProject {
  id              String      @id @default(cuid())
  userId          String
  title           String
  sourceVideoUrl  String
  status          String      @default("PROCESSING") // PROCESSING | READY | FAILED
  transcript      String?
  viralHooksJson  String?     // Array of 5 hook variants
  xThreadJson     String?     // Formatted multi-tweet thread
  linkedInPost    String?     // Long-form markdown post
  clips           VideoClip[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model VideoClip {
  id            String         @id @default(cuid())
  projectId     String
  project       ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startTime     Int            // seconds
  endTime       Int            // seconds
  clipUrl       String?
  isWatermarked Boolean        @default(true) // false for Copilot users
  status        String         @default("PENDING") // PENDING | RENDERING | READY
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

